# Copy to .env and fill in. Both are optional.

# Weights & Biases. Without it, metrics print to stdout only.
WANDB_API_KEY=
WANDB_PROJECT=prism-grpo

# Hugging Face token. Needed only for gated models; raises the hub rate limit otherwise.
HF_TOKEN=

# Optional: relocate the model/dataset cache off the system drive.
# HF_HOME=D:/hf_cache
